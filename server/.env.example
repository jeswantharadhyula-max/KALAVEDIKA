# Copy this file to server/.env (never commit .env to git)
# These variables run the EXPRESS BACKEND on Render

# Secret key for signing JWTs — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Your Vercel frontend URL (set this after you deploy to Vercel)
CLIENT_URL=https://your-app.vercel.app

# Port (Render sets this automatically — do NOT change)
# PORT=3001

# Optional: Supabase (only needed if backend uses Supabase directly)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
