# Copy this file to .env.local and fill in your real values
# NEVER commit .env or .env.local to git — only this example file is safe to commit

# Supabase (Frontend) — get these from your Supabase project dashboard
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL — replace with your deployed backend URL (Railway/Render/etc.)
VITE_API_URL=https://your-backend-url.com
